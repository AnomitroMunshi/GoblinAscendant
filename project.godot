; Engine configuration file.
; Owned by the lead developer. Request changes instead of editing directly.

config_version=5

[application]

config/name="Goblin Ascendant"
config/description="A small goblin's journey toward becoming the Demon Emperor. Chapter 1."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Events="*res://scripts/core/events.gd"
Settings="*res://scripts/core/settings.gd"
SaveManager="*res://scripts/core/save_manager.gd"
GameState="*res://scripts/core/game_state.gd"
Factions="*res://scripts/core/factions.gd"
GameFeel="*res://scripts/core/game_feel.gd"
Audio="*res://scripts/audio/audio.gd"
Progression="*res://scripts/progression/progression.gd"
Quests="*res://scripts/quests/quest_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="actors"
3d_physics/layer_4="hitbox"
3d_physics/layer_5="interact"
3d_physics/layer_6="trigger"
3d_physics/layer_7="water"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.55, 0.72, 0.88, 1)
